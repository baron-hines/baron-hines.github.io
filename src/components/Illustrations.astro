---
// Wraps a post's or project's rendered Markdown and puts each hand-drawn
// illustration's SVG markup into the page in place of its <img>, so the
// SVG's <style> sees the theme tokens and it follows the light/dark toggle.
//
// In Markdown, an illustration is an HTML block on its own line, with the
// .svg next to the Markdown file:
//
//   <img class="illustration" src="coding-stack.svg" alt="…">
//
// GitHub shows that as an ordinary image, in the SVG's fallback colors.
interface Props {
  /** The content collection the Markdown is in: "blog" or "projects". */
  collection: string;
}

const { collection } = Astro.props;

const svgs = import.meta.glob<string>("/src/content/**/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});

const html = (await Astro.slots.render("default")).replace(/<img\b[^>]*>/g, (tag) => {
  if (!/\bclass="illustration"/.test(tag)) return tag;
  const src = tag.match(/\bsrc="([^"]+\.svg)"/)?.[1];
  const svg = src && svgs[`/src/content/${collection}/${src.replace(/^\.\//, "")}`];
  if (!svg) throw new Error(`Illustration ${src ?? tag} not found in src/content/${collection}/`);
  return `<figure class="diagram illustration">${svg.replace(/^<\?xml[^>]*>\s*/, "").trim()}</figure>`;
});
---

<Fragment set:html={html} />
