---
// The projects rail beside the posts on the home page: a heading, a short
// stack of link cards, and a link on to /projects/. It is the only page with a
// rail, so the home page shows both sections while /blog/ and /projects/ stay
// single lists.
import Status from "./Status.astro";
import { projects } from "../lib/content";

// Active projects first; if none are active, the finished ones, so the rail
// never disappears and the layout never collapses.
const allProjects = await projects();
const active = allProjects.filter((p) => p.data.status === "active");
const items = active.length > 0 ? active : allProjects;
const heading = active.length > 0 ? "Projects" : "Recently finished";
---

{
  items.length > 0 && (
    <aside class="rail" aria-labelledby="rail-heading">
      <h2 class="section-label" id="rail-heading">{heading}</h2>
      <ul class="rail__list">
        {items.map((project) => (
          <li class="rail__item">
            <h3 class:list={["rail__title", { "keep-case": project.data.keepCase }]}>
              <a href={`/projects/${project.id}/`}>{project.data.title}</a>
            </h3>
            <p class="rail__summary">{project.data.summary}</p>
            <Status status={project.data.status} />
          </li>
        ))}
      </ul>
      <p class="rail__more"><a href="/projects/">All projects</a></p>
    </aside>
  )
}
