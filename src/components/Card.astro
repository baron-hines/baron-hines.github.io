---
// One entry in a list: a post or a project. The whole card is clickable.
interface Props {
  href: string;
  title: string;
  summary: string;
  /** The title is a lowercase name that keeps its case in uppercase themes. */
  keepCase?: boolean;
}

const { href, title, summary, keepCase = false } = Astro.props;
const hasMeta = Astro.slots.has("default");
---

<li class="card">
  <h3 class:list={["card__title", { "keep-case": keepCase }]}><a href={href}>{title}</a></h3>
  <p class="card__summary">{summary}</p>
  {hasMeta && <div class="card__meta"><slot /></div>}
</li>
