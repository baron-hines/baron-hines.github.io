---
import "../styles/theme.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Sora:wght@600&family=IBM+Plex+Sans:wght@400;500&family=IBM+Plex+Mono:wght@500&family=Chakra+Petch:wght@600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <!-- Blocking on purpose: applies the saved theme before the first paint. -->
    <script is:inline src="/theme.js"></script>
  </head>
  <body>
    <slot />
  </body>
</html>
