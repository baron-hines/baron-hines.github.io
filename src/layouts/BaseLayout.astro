---
import "../styles/theme.css";
import "../styles/code.css";

interface Props {
  title: string;
  /** Used for the meta description and link previews (site-plan D6e). */
  description?: string;
  /** "article" for posts and projects; "website" otherwise. */
  type?: "website" | "article";
  /** Nav section to mark as current when the URL doesn't say, e.g. "/projects/". */
  section?: string;
  /** Widen the content shell, for pages with a side column (the home page). */
  wide?: boolean;
}

const SITE = "baron-hines";
const { title, description = "Notes and projects.", type = "website", section, wide = false } = Astro.props;
const fullTitle = title === SITE ? SITE : `${title} · ${SITE}`;
const url = new URL(Astro.url.pathname, Astro.site);
// The dev server and the build report "/projects" and "/projects/" differently,
// so compare with one trailing slash and no index.html.
const path = Astro.url.pathname.replace(/index\.html$/, "").replace(/\/?$/, "/");

const nav = [
  { href: "/blog/", label: "Blog" },
  { href: "/projects/", label: "Projects" },
  { href: "/about/", label: "About" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:site_name" content={SITE} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={url} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#f7fbfc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#05080a" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="mask-icon" href="/favicon.svg" color="#0e7490" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE} blog`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Sora:wght@600&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&family=Chakra+Petch:wght@600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <slot name="head" />
    <!-- Blocking on purpose: applies the saved theme before the first paint. -->
    <script is:inline src="/theme.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="site-name keep-case" href="/" aria-current={path === "/" ? "page" : undefined}>
          <svg class="site-mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
            <rect x="4.5" y="4.5" width="23" height="23" rx="5" />
            <path d="M12 10.5v11M12 16h8M20 10.5v11" />
          </svg>
          {SITE}
        </a>
        <nav aria-label="Sections">
          <ul class="site-nav">
            {
              nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={path === item.href ? "page" : path.startsWith(item.href) || section === item.href ? "true" : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <button class="theme-toggle" type="button" hidden>dark</button>
      </div>
    </header>
    <main id="main" class:list={["container", { "container--wide": wide }]}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container site-footer__inner">
        <a class="repo-link" href="/rss.xml">
          {/* The standard RSS glyph, drawn in the text color. */}
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="5" cy="19" r="1.6" fill="currentColor" stroke="none" />
            <path d="M4 11a9 9 0 0 1 9 9" />
            <path d="M4 4a16 16 0 0 1 16 16" />
          </svg>
          RSS
        </a>
        <a class="repo-link" href="https://github.com/baron-hines">
          {/* GitHub's mark (Primer Octicons "mark-github", MIT), as on the project pages. */}
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
            <path fill="currentColor" d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z" />
          </svg>
          GitHub
        </a>
        <a class="repo-link" href="https://www.linkedin.com/in/baronhines/">
          {/* A plain "in" in a box, drawn in the text color so it follows the theme. Not LinkedIn's logo. */}
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="2" width="20" height="20" rx="3" />
            <circle cx="7" cy="7.5" r="1.1" fill="currentColor" stroke="none" />
            <path d="M7 10.5v7" stroke-linecap="round" />
            <path d="M11 17.5v-7M11 13.5c0-1.8 1.2-3 2.8-3s2.7 1.1 2.7 3v4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          LinkedIn
        </a>
      </div>
    </footer>
  </body>
</html>
