---
import BaseLayout from "../layouts/BaseLayout.astro";
import Card from "../components/Card.astro";
import SideRail from "../components/SideRail.astro";
import { formatDate, posts } from "../lib/content";

const latest = (await posts()).slice(0, 3);
---

<BaseLayout title="baron-hines" wide>
  <h1 class="keep-case">baron-hines</h1>
  <p class="muted">Notes on what I'm building, how my machines and AI tools fit together, and the projects behind them.</p>

  <div class="home">
    <div class="home__main">
      <h2 class="section-label">Latest posts</h2>
      {
        latest.length > 0 ? (
          <ul class="cards">
            {latest.map((post) => (
              <Card href={`/blog/${post.id}/`} title={post.data.title} summary={post.data.summary}>
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
              </Card>
            ))}
          </ul>
        ) : (
          <p class="empty">No posts yet.</p>
        )
      }
      {latest.length > 0 && <p><a href="/blog/">All posts</a></p>}
    </div>

    <SideRail exclude="blog" />
  </div>
</BaseLayout>
