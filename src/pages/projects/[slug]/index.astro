---
import { render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Illustrations from "../../../components/Illustrations.astro";
import Mermaid from "../../../components/Mermaid.astro";
import Status from "../../../components/Status.astro";
import Tags from "../../../components/Tags.astro";
import Updated from "../../../components/Updated.astro";
import { hasMermaid, projects } from "../../../lib/content";

export async function getStaticPaths() {
  return (await projects()).map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const links = project.data.links;
const repo = project.data.repo;
// Labelled the way GitHub shows a repo: "owner/name".
const repoName = repo?.replace(/^https:\/\/github\.com\//, "").replace(/\/$/, "");
---

<BaseLayout title={project.data.title} description={project.data.summary} type="article">
  <article>
    <h1 class:list={{ "keep-case": project.data.keepCase }}>{project.data.title}</h1>
    <div class="article-meta">
      <Status status={project.data.status} />
      <Updated id={project.id} />
      <Tags tags={project.data.tags} />
    </div>
    <p>{project.data.summary}</p>
    {
      (links.length > 0 || repo) && (
        <ul class="project-links">
          {links.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
          {repo && (
            <li class="project-links__repo">
              <a class="repo-link" href={repo} aria-label={`${repoName} on GitHub`}>
                {/* GitHub's mark (Primer Octicons "mark-github", MIT). */}
                <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                  <path fill="currentColor" d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z" />
                </svg>
                {repoName}
              </a>
            </li>
          )}
        </ul>
      )
    }
    <div class="prose"><Illustrations collection="projects"><Content /></Illustrations></div>
  </article>
  <p class="more"><a class="more-link more-link--back" href="/projects/">All projects</a></p>
  {hasMermaid(project.body) && <Mermaid />}
</BaseLayout>
